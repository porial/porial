# Porial — configuration de DÉMONSTRATION, instance autonome (sans Control Plane).
#
# Usage : démonstrations sur des données NON SENSIBLES, sur un réseau local de confiance.
# Les garde-fous de sécurité sont volontairement coupés ou relâchés (détection d'intrusion,
# temporisation des mots de passe, anti-SSRF, cookies Secure…). Ne pas employer telle quelle
# pour une installation réelle : partir alors de etc/.env.example du livrable.
#
# APP_SECRET et GOBIM_UNIVERSE_ID sont laissés vides ici : la commande d'installation les tire
# au hasard ; à défaut, le conteneur les génère au premier démarrage et les garde dans son volume
# de données (data/.generated.env). Ne jamais publier un secret renseigné.
#
# La base (nom, compte, mot de passe, port) est décrite dans docker-compose.yml.

# --- Ports de la machine ---------------------------------------------------------------------
# Ports publiés sur la machine (lus par docker-compose.yml). À changer si déjà pris, puis
# `docker compose up -d`. Penser à reporter le port du site dans SITE_URL.
PORIAL_PORT=8080
POSTGRES_PORT=54320

# --- Serveur ---------------------------------------------------------------------------------
APP_ENV=production
HTTP_ADDR=:8080
SITENAME=Porial
# Adresse sous laquelle le site est ouvert (liens des e-mails, origine WebAuthn). Mettre l'adresse
# de la machine sur le réseau local, par exemple http://192.168.1.20:8080.
SITE_URL=http://localhost:8080
INSTANCE_NAME=porial
APP_SECRET=
# Identité de l'instance autonome : UUID fixé une fois pour toutes (mode 1 instance = 1 site).
GOBIM_UNIVERSE_ID=
# Superuser (compte plateforme) du site, créé au premier démarrage seulement, tant qu'aucun
# superuser n'existe ; ignoré ensuite (modifier ces valeurs ne change plus rien). Valeurs
# d'EXEMPLE : la commande d'installation les tire au hasard. Changer le mot de passe depuis le
# profil après la première connexion.
INITIAL_SUPERUSER_EMAIL=admin-d9ba7f@porial.local
INITIAL_SUPERUSER_PASSWORD=fbmvF5HSM8JXdH8x
# Premier démarrage : applique tous les jeux de données de départ (référentiels et objets de
# démonstration, écran Administration › Site › Données de départ). Une seule fois : un élément
# supprimé ensuite ne revient pas.
SEED_DATA_ON_FIRST_START=true
# Crée et met à jour le schéma à chaque démarrage : une nouvelle image s'applique d'elle-même.
INIT_SCHEMA=true
DB_AUTO_CREATE=true
TZ=Europe/Paris

# --- Accès réseau local tout ouvert ----------------------------------------------------------
# Site servi en http:// sans proxy TLS : cookies de session sans attribut Secure (sinon le
# navigateur les refuse hors localhost et la connexion est impossible).
SESSION_ALLOW_INSECURE_HTTP=true
# Accès direct, sans proxy inverse : l'adresse de la connexion identifie le client.
RATELIMIT_CLIENT_IP=remote
# Connexions sortantes (sources ETL, intégrations, IA locale…) permises vers tout le réseau.
SAFEFETCH_ALLOWED_NETWORKS=ALL

# --- Garde-fous désactivés pour la démonstration ---------------------------------------------
# Détection d'intrusion et blocage d'adresses coupés.
ELEPHANT_ENABLED=false
ELEPHANT_BLOCK_ENABLED=false
ELEPHANT_FLOOD_ENABLED=false
ELEPHANT_ALERT_ENABLED=false
ELEPHANT_GEOIP_ENABLED=false
# Mots de passe : longueur minimale basse, pas de temporisation ni de verrouillage pratique.
PASSWORD_MIN_LENGTH=8
PASSWORD_THROTTLE_BASE_SECONDS=1
PASSWORD_THROTTLE_MAX_SECONDS=1
PASSWORD_LOCK_AFTER_FAILURES=1000
PASSWORD_LOCK_DURATION_HOURS=1
# Ni reconnexion pour les opérations sensibles, ni second facteur imposé.
REQUIRE_RECENT_AUTHENTICATION=false
MFA_REQUIRED_FOR_ADMIN_ROLES=false
SUPERUSER_STRONG_AUTH_EXEMPT=true
# Sessions longues.
SESSION_TTL=720h
SESSION_REMEMBER_TTL=720h
SESSION_ABSOLUTE_TTL=720h
# Un administrateur du site peut obtenir une clé d'API.
GOBIM_API_ALLOW_ADMIN_ACCOUNTS=true

# --- E-mails ---------------------------------------------------------------------------------
# Aucun serveur SMTP : la connexion par code e-mail est coupée, seul le mot de passe sert.
# Renseigner EMAIL_HOST… et repasser ENABLE_EMAIL_CODE_LOGIN à true pour les invitations.
ENABLE_EMAIL_CODE_LOGIN=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=porial@porial.local
